    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "FileChanged": [
      {
        "matcher": "**/*.{ts,tsx}",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y tsc --noEmit"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/notify-telegram.cjs permission"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/notify-telegram.cjs complete"
          }
        ]
      }
    ]
  }
}

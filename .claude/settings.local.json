      "Bash(git reset *)",
      "Bash(git commit -m '프로젝트 개발 가이드 CLAUDE.md 추가 *)",
      "Bash(gh auth *)",
      "PowerShell(gh auth *)",
      "Bash(git branch *)",
      "Bash(git remote *)",
      "Bash(git push *)",
      "Bash(git commit -m '프로젝트 README 작성 *)",
      "Bash(git commit -m '로컬 개발 환경 설정 파일을 .gitignore에 추가 *)",
      "Skill(code_review)",
      "WebSearch",
      "WebFetch(domain:core.telegram.org)",
      "WebFetch(domain:docs.claude.com)",
      "Bash(git commit -m '🔔 feat: Claude Code 훅 + 텔레그램 알림 통합 *)",
      "Bash(npx tsc *)",
      "Bash(node .claude/hooks/typecheck.cjs)",
      "mcp__sequential-thinking__sequentialthinking",
      "mcp__shadcn",
      "Bash(npx shadcn-ui@latest *)",
      "Bash(npx shadcn@latest *)",
      "Bash(netstat -ano)",
      "Bash(findstr :3000)",
      "PowerShell(head -50)",
      "PowerShell(git add -A)",
      "PowerShell(git reset HEAD)",
      "PowerShell(git add CLAUDE.md)",
      "PowerShell(git add package.json package-lock.json)",

# 텔레그램 봇 토큰
# 1) 텔레그램에서 @BotFather 검색 → /newbot 실행 → 안내에 따라 봇 이름/username 입력
# 2) 발급된 토큰을 아래에 붙여넣기 (형식 예: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
TELEGRAM_BOT_TOKEN=

# 알림을 받을 나의 텔레그램 chat_id
# 1) 방금 만든 봇을 텔레그램에서 검색해 대화방을 열고 /start 를 먼저 보낼 것 (필수 — 안 하면 봇이 메시지를 보낼 수 없음)
# 2) @userinfobot 을 검색해 /start 를 보내면 본인의 숫자 ID(Id: 987654321)를 즉시 알려줌
TELEGRAM_CHAT_ID=
